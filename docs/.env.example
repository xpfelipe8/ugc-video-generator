# ===== Copie este arquivo para .env e ajuste (o install.sh faz isso por você) =====

# Servidor
PORT=5000

# IA (opcional). Sem chaves, o roteiro é dividido localmente e o vídeo fica sem voz.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Fila: quantos vídeos renderizar ao mesmo tempo (4K consome muita CPU/RAM)
MAX_CONCURRENT_JOBS=2

# Vídeo
VIDEO_FPS=30
X264_PRESET=veryfast      # ultrafast | veryfast | fast | medium (mais lento = menor arquivo)
X264_CRF=18               # 14-23: menor = melhor qualidade, arquivo maior

# Caminhos (opcional)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FONT_FILE=/caminho/para/fonte-bold.ttf
# DATA_DIR=data
