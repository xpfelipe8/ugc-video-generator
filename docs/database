'use strict';
/**
 * database.js — Inicializa o SQLite (arquivo único, sem servidor),
 * cria as tabelas e carrega os templates pré-configurados.
 */
const Database = require('better-sqlite3');
const config = require('./config');
const logger = require('./logger');

const db = new Database(config.DB_PATH);
db.pragma('journal_mode = WAL');
db.pragma('foreign_keys = ON');

db.exec(`
  CREATE TABLE IF NOT EXISTS users (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    name       TEXT NOT NULL,
    email      TEXT UNIQUE,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
  );

  CREATE TABLE IF NOT EXISTS templates (
    id          TEXT PRIMARY KEY,
    name        TEXT NOT NULL,
    description TEXT NOT NULL,
    config      TEXT NOT NULL            -- JSON com cores, efeito, posição do texto
  );

  CREATE TABLE IF NOT EXISTS videos (
    id           TEXT PRIMARY KEY,       -- UUID
    user_id      INTEGER NOT NULL DEFAULT 1 REFERENCES users(id),
    title        TEXT NOT NULL,
    script       TEXT NOT NULL,
    template_id  TEXT NOT NULL REFERENCES templates(id),
    quality      TEXT NOT NULL,
    aspect       TEXT NOT NULL,
    use_ai       INTEGER NOT NULL DEFAULT 1,
    use_voice    INTEGER NOT NULL DEFAULT 0,
    status       TEXT NOT NULL DEFAULT 'queued',  -- queued | processing | completed | failed
    file_path    TEXT,
    duration_sec REAL,
    file_size    INTEGER,
    width        INTEGER,
    height       INTEGER,
    error        TEXT,
    created_at   TEXT NOT NULL DEFAULT (datetime('now')),
    completed_at TEXT
  );

  CREATE TABLE IF NOT EXISTS jobs (
    id          TEXT PRIMARY KEY,        -- UUID
    video_id    TEXT NOT NULL REFERENCES videos(id) ON DELETE CASCADE,
    status      TEXT NOT NULL DEFAULT 'queued',
    stage       TEXT NOT NULL DEFAULT 'Na fila',
    progress    INTEGER NOT NULL DEFAULT 0,       -- 0 a 100
    error       TEXT,
    log         TEXT NOT NULL DEFAULT '',
    created_at  TEXT NOT NULL DEFAULT (datetime('now')),
    started_at  TEXT,
    finished_at TEXT
  );

  CREATE INDEX IF NOT EXISTS idx_videos_created ON videos(created_at DESC);
  CREATE INDEX IF NOT EXISTS idx_jobs_status ON jobs(status, created_at);
`);

// Usuário padrão (o projeto não exige login por padrão)
db.prepare(`INSERT OR IGNORE INTO users (id, name, email) VALUES (1, 'Padrão', NULL)`).run();

