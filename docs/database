const upsert = db.prepare(
  `INSERT INTO templates (id, name, description, config) VALUES (@id, @name, @description, @config)
   ON CONFLICT(id) DO UPDATE SET name = excluded.name, description = excluded.description, config = excluded.config`
);
db.transaction(() => {
  for (const t of TEMPLATES) upsert.run({ id: t.id, name: t.name, description: t.description, config: JSON.stringify(t.config) });
})();

logger.info(`Banco de dados pronto em ${config.DB_PATH}`);

module.exports = db;
